# Model Service Configuration

# Port the Flask service listens on
MODEL_SERVICE_PORT=8081

# Directory where models are cached
MODEL_DIR=/app/models

# Model version to download from GitHub Releases
MODEL_VERSION=latest

# GitHub repository for model downloads
GITHUB_REPO=doda2025-team8/model-service

# NLTK data path (pre-configured in container)
NLTK_DATA=/usr/share/nltk_data
